# ==== Hermes Agent Configuration ====

# --- Otak (LLM) ---
# provider: rule | openai | anthropic | google | ollama
HERMES_BRAIN_PROVIDER=rule
# OpenAI
# openai-compatible endpoint: LM Studio, vLLM, Ollama, OpenRouter, Groq, dll.
# contoh:
#   OpenAI resmi   : https://api.openai.com/v1
#   Ollama lokal   : http://host.docker.internal:11434/v1
#   LM Studio      : http://host.docker.internal:1234/v1
#   OpenRouter     : https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Google Gemini
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-flash
# Ollama (lokal)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# ID Telegram kamu (dari @userinfobot) — kosong = terima siapa saja (tidak disarankan)
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Portal Web (Playwright) ---
PORTAL_BASE_URL=
PORTAL_USERNAME=
PORTAL_PASSWORD=

# --- Google Sheets ---
# Path ke file service-account JSON dari Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_ID=

# --- Aplikasi ---
HERMES_DB_PATH=data/hermes.sqlite
HERMES_TEMPLATE_DIR=templates
HERMES_OUTPUT_DIR=output
# Umur maksimum berkas hasil unduhan di `output/` (hari). Resep
# `bersih_output` menghapus yang lebih tua dari ini, sekali seminggu.
HERMES_OUTPUT_RETENSI_HARI=7
HERMES_LOG_LEVEL=INFO

# --- Antarmuka Web ---
# 127.0.0.1 = hanya localhost (aman). 0.0.0.0 = terbuka ke jaringan (hati-hati, UI ini TANPA login).
# Saat Docker: biarkan 0.0.0.0 agar port bisa di-mapping ke host.
HERMES_WEB_HOST=0.0.0.0
HERMES_WEB_PORT=10000

# --- Bitwarden (opsional, via Docker secret) ---
# Master password vault TIDAK di file ini. Tulis ke:
#   echo -n "master-password-anda" > secrets/bw_masterpass
# Entrypoint: login otomatis (bila belum) lalu unlock, tiap container start.
BW_EMAIL=

# --- Autopilot (daemon otonom) ---
# 1=aktif: recipe berjalan sendiri mengikuti jadwalnya. 0=manual saja.
HERMES_AUTOPILOT=1

# --- Autopilot E-Cuti (kompatibilitas .env lama) ---
# Jadwal & startup e-cuti dibaca dari sini; bisa juga ditulis langsung
# sebagai `schedule` di hermes/recipes.py.
ECUTI_AUTOPILOT=1
ECUTI_ON_START=1
ECUTI_DAILY_AT=07:00
